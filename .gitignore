# CMake build directory
build/

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Test Results
*.out.xml
cpputest_*.xml

# vscode logs
*.log

# Local devcontainer Dockerfile (not committed - see .devcontainer/Dockerfile header)
.devcontainer/Dockerfile

# compile_commands.json copied to workspace root by CMake Tools extension
compile_commands.json

# BDD output (syslog-ng or OTel collector writes here at runtime)
Bdd/output/*
!Bdd/output/.gitkeep
Bdd/junit/*
!Bdd/junit/.gitkeep

# FatFs semihosting disk image — QEMU creates this at its cwd
# (the project root) per DISK_IMAGE_PATH in Bdd/Targets/Boards/Mps2An385/BddTargetBoardDisk.c.
# after_scenario removes it between scenarios, but an aborted run can
# leave the file behind; never commit it.
solidsyslog-disk.img

# OTel Collector binary downloaded by Bdd/otel/Install-OtelCollector.ps1
Bdd/otel/bin/

# Python bytecode (BDD steps)
__pycache__/
*.pyc

# BDD-side mirror of build-time tunables, generated by CMake configure_file
# from Bdd/features/steps/solidsyslog_tunables.py.in
Bdd/features/steps/solidsyslog_tunables.py

# MkDocs site build output and the mkdoxy-generated API reference
# (regenerated from Core/Interface/*.h on every docs build)
/site/
/docs/api/

# The coverage lane's genhtml report and tracefile, staged here by docs-build
# for the Testing pages (hooks/coverage_report.py). No trailing slash: a
# directory-only pattern matches nothing until the directory exists, and
# scripts/check_references.py asks git about the path in a tree without it.
/docs/testing/coverage-report

# The test report scripts/junit_report_pages.py generates from the run's JUnit
# artifacts, staged here by docs-build for the Testing pages (hooks/test_report.py)
/docs/testing/test-report

# Claude Code local config
.claude/
pr*-comments.json
